# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
env/
venv/
ENV/

# Data directories (raw, intermediate, processed)
# Keep directory structure via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/intermediate/*
!data/intermediate/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Cache & temporary files
.tiktoken_cache/
.pytest_cache/
.coverage
htmlcov/
*.log
.DS_Store

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Model Checkpoints & Training Artifacts
checkpoints/*
!checkpoints/.gitkeep
*.pt

# IDE files
.vscode/
.idea/
